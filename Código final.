// Otras funciones
//******************************************/

//******************************************/
// Funciones LED RGB
//******************************************/

// Apagar completamente los tres canales del LED RGB
void apagarRGB() {
  ledcWrite(CANAL_ROJO, 0);
  ledcWrite(CANAL_VERDE, 0);
  ledcWrite(CANAL_AZUL, 0);
}

// Encender solamente el color rojo
void colorRojo() {
  apagarRGB();
  ledcWrite(CANAL_ROJO, 255);
}

// Encender solamente el color verde
void colorVerde() {
  apagarRGB();
  ledcWrite(CANAL_VERDE, 255);
}

// Encender solamente el color azul
void colorAzul() {
  apagarRGB();
  ledcWrite(CANAL_AZUL, 255);
}

// El amarillo se obtiene combinando rojo y verde
void colorAmarillo() {
  apagarRGB();
  ledcWrite(CANAL_ROJO, 255);
  ledcWrite(CANAL_VERDE, 255);
}

//******************************************/
// Funciones Servo
//******************************************/

// Posicionar la rejilla en 0 grados
void servoCerrado() {
  ledcWrite(CANAL_SERVO, SERVO_CERRADO);
}

// Posicionar la rejilla aproximadamente en 45 grados
void servoMedio() {
  ledcWrite(CANAL_SERVO, SERVO_MEDIO);
}

// Posicionar la rejilla en 90 grados
void servoAbierto() {
  ledcWrite(CANAL_SERVO, SERVO_ABIERTO);
}

//******************************************/
// Funciones Display
//******************************************/

// Apagar todos los segmentos
void apagarSegmentos() {
  digitalWrite(SEG_A, LOW);
  digitalWrite(SEG_B, LOW);
  digitalWrite(SEG_C, LOW);
  digitalWrite(SEG_D, LOW);
  digitalWrite(SEG_E, LOW);
  digitalWrite(SEG_F, LOW);
  digitalWrite(SEG_G, LOW);
  digitalWrite(SEG_DP, LOW);
}

// Desactivar los tres displays
void apagarDigitos() {
  digitalWrite(DIGITO_1, LOW);
  digitalWrite(DIGITO_2, LOW);
  digitalWrite(DIGITO_3, LOW);
}

// Mostrar un numero del 0 al 9 en las lineas
// compartidas de los displays
void mostrarNumero(int numero) {
  apagarSegmentos();

  digitalWrite(SEG_A, numeros[numero][0]);
  digitalWrite(SEG_B, numeros[numero][1]);
  digitalWrite(SEG_C, numeros[numero][2]);
  digitalWrite(SEG_D, numeros[numero][3]);
  digitalWrite(SEG_E, numeros[numero][4]);
  digitalWrite(SEG_F, numeros[numero][5]);
  digitalWrite(SEG_G, numeros[numero][6]);
}

//******************************************/
// Lectura del LM35
//******************************************/
void leerTemperatura() {

  // Durante las pruebas se determino que las cargas
  // digitales podian alterar la lectura del ADC.
  // Por esta razon el RGB se apaga antes de medir.
  apagarRGB();

  // Pausar temporalmente el multiplexeo para evitar
  // interferencias durante la lectura analogica
  timerAlarmDisable(timerDisplay);

  apagarDigitos();
  apagarSegmentos();

  // Esperar a que la señal del LM35 se estabilice
  delay(100);

  // Primera lectura utilizada como descarte
  // para estabilizar el ADC
  analogReadMilliVolts(LM35_PIN);
  delay(10);

  // Obtener directamente el voltaje del LM35
  // expresado en milivoltios
  uint32_t milivoltios = analogReadMilliVolts(LM35_PIN);

  // El LM35 entrega aproximadamente 10 mV
  // por cada grado Celsius
  temperatura = milivoltios / 10.0;

  // Convertir la temperatura a un entero para poder
  // separarla entre los tres displays.
  //
  // Ejemplo:
  // 25.4 C -> 254
  tempDisplay = (int)(temperatura * 10.0 + 0.5);

  // Los tres displays permiten representar como
  // maximo un valor de 99.9
  if (tempDisplay > 999) {
    tempDisplay = 999;
  }

  // Proteger la actualizacion de las variables
  // compartidas con la rutina de interrupcion
  portENTER_CRITICAL(&timerMux);

  // Separar el valor en tres digitos.
  //
  // Ejemplo:
  // 254 -> 2 | 5 | 4
  //
  // En los displays se observa 25.4
  decenas = tempDisplay / 100;
  unidades = (tempDisplay / 10) % 10;
  decimal = tempDisplay % 10;

  // Reiniciar el multiplexeo desde el primer display
  digitoActual = 0;

  portEXIT_CRITICAL(&timerMux);

  // Reactivar el Timer despues de terminar
  // la lectura del LM35
  timerAlarmEnable(timerDisplay);

  //******************************************/
  // Mostrar resultados en el monitor serial
  //******************************************/

  Serial.println("----------------");

  Serial.print("Voltaje: ");
  Serial.print(milivoltios);
  Serial.println(" mV");

  Serial.print("Temperatura: ");
  Serial.print(temperatura, 1);
  Serial.println(" C");

  Serial.print("Display: ");
  Serial.print(decenas);
  Serial.print(unidades);
  Serial.print(".");
  Serial.println(decimal);
}

//******************************************/
// Estado termico
//******************************************/
void actualizarEstado() {

  //******************************************/
  // Riesgo por frio
  // T < 23 C
  // Azul + rejilla cerrada
  //******************************************/
  if (temperatura < 23.0) {
    estadoTemperatura = 0;
    estadoRejilla = "Cerrado";

    colorAzul();
    servoCerrado();

    Serial.println("RIESGO POR FRIO");
    Serial.println("LED: AZUL");
    Serial.println("REJILLA: CERRADO - 0 grados");
  }

  //******************************************/
  // Rango seguro
  // 23 C <= T < 25 C
  // Verde + rejilla media
  //******************************************/
  else if (temperatura < 25.0) {
    estadoTemperatura = 1;
    estadoRejilla = "Medio";

    colorVerde();
    servoMedio();

    Serial.println("RANGO SEGURO");
    Serial.println("LED: VERDE");
    Serial.println("REJILLA: MEDIO - 45 grados");
  }

  //******************************************/
  // Cerca del limite
  // 25 C <= T < 27 C
  // Amarillo + rejilla media
  //******************************************/
  else if (temperatura < 27.0) {
    estadoTemperatura = 2;
    estadoRejilla = "Medio";

    colorAmarillo();
    servoMedio();

    Serial.println("CERCA DEL LIMITE");
    Serial.println("LED: AMARILLO");
    Serial.println("REJILLA: MEDIO - 45 grados");
  }

  //******************************************/
  // Riesgo por calor
  // T >= 27 C
  // Rojo + rejilla abierta
  //******************************************/
  else {
    estadoTemperatura = 3;
    estadoRejilla = "Abierto";

    colorRojo();
    servoAbierto();

    Serial.println("RIESGO POR CALOR");
    Serial.println("LED: ROJO");
    Serial.println("REJILLA: ABIERTO - 90 grados");
  }
}

//******************************************/
// Envio a Adafruit IO
//******************************************/
void enviarAdafruit() {

  // Enviar la temperatura obtenida por el LM35
  // al feed "temperatura"
  canalTemperatura->save(temperatura);

  // Enviar el estado actual de la rejilla
  // al feed "rejilla"
  canalRejilla->save(estadoRejilla);

  Serial.println("Datos enviados a Adafruit IO");
}
